# LifeLevel Production Environment Configuration Template
# Copy this file to .env and provide your actual credentials.

# Server Port
PORT=5001

# Environment ('production' | 'development')
NODE_ENV=production

# Live MongoDB Connection URL (e.g. MongoDB Atlas cluster)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifelevel?retryWrites=true&w=majority

# Local MongoDB URI fallback (optional, for local development)
MONGODB_URI=mongodb://127.0.0.1:27017/lifelevel

# Brevo (Sendinblue) Transactional API Key (v3 API key starting with xkeysib-)
BREVO=xkeysib-your-brevo-api-key-here

# JWT Signing Secret (generate a strong random string)
JWT_SECRET=your-production-jwt-secret-string-here

# Application Sender Email for Transactional Brevo Emails
APP_SENDER_EMAIL=madhvagadge03@gmail.com

# Google Authentication (Sign in with Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:support@padhaku-billa.com



