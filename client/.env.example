# Google OAuth Client ID for frontend Google Identity Services
# Configure in Vercel project environment variables
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Web Push Notifications Public Key (optional: auto-discovered from backend if omitted)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here


# Backend API Base URL (optional override)
# VITE_API_BASE=https://your-backend-domain.com/api

